{
  "name": "crm-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise CRM API (Node.js / Express / PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "setup": "node src/migrate.js && node src/seed.js",
    "test": "node src/reset.js && node --test --test-concurrency=1 test/*.test.js",
    "reset": "node src/reset.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1"
  }
}